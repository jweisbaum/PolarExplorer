{
  "name": "polarexplorer",
  "private": true,
  "version": "0.3.8",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "dev": "tauri dev",
    "dev:webdriver": "tauri dev --features webdriver",
    "build": "tauri build",
    "tauri": "tauri",
    "ui:dev": "npm run dev -w ui",
    "ui:typecheck": "npm run typecheck -w ui",
    "ui:test": "npm run test -w ui",
    "ui:perf": "npm run test:perf -w ui",
    "ui:build": "npm run build -w ui",
    "bindings": "cargo run -p pe-app --example export_bindings",
    "check:offline": "./tools/check-offline.sh",
    "tools:test": "node --test tools/webdriver/client.test.mjs tools/webdriver/mcp.test.mjs",
    "ux": "node tools/webdriver/ux/run.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@tauri-apps/cli": "^2.11.4",
    "zod": "^4.6.5"
  }
}
