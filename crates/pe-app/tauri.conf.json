{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PolarExplorer",
  "version": "0.3.8",
  "identifier": "com.polareffects.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PolarExplorer",
        "maximized": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Build sailing polars from certificates, polar files and race tracks.",
    "category": "Sports",
    "resources": {
      "../../docs/USER-GUIDE.md": "documentation/USER-GUIDE.md",
      "../../docs/DATA-SOURCES.md": "documentation/DATA-SOURCES.md",
      "../../docs/licenses/orc-data-MIT.txt": "documentation/licenses/orc-data-MIT.txt"
    }
  }
}
